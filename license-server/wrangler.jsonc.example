{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "price-monitor-license",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "price-monitor-license",
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ]
}
