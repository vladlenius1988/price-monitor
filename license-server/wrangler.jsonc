{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "price-monitor-license",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "price-monitor-license-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "SERVICE_VERSION": "4.24.0",
        "RATE_LIMITING_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "price-monitor-staging",
          "database_id": "3d621aaf-9570-4d25-b0b7-5a6b86795aa9",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "price-monitor-license-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "SERVICE_VERSION": "4.24.0",
        "RATE_LIMITING_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "price-monitor-production",
          "database_id": "628fb244-6c20-48bf-8b6d-6957f3ef53d8",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["17 3 * * *"]
      }
    }
  }
}
